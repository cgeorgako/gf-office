//// GF-DGM - Μενού ProgeCAD για τα εργαλεία DGM.lsp
//// Φόρτωση: εντολή MENULOAD και επιλογή του DGM.mnu
//// Δύο βασικές κατηγορίες: Α. Τοπογραφικά   Β. ΔΓΜ
//// Η δομή ακολουθεί τις τυπικές ροές εργασίας του εγχειριδίου KtimaDGM (κεφ. 9)

***MENUGROUP=DGM

***POP1
**DGMTOPO
[Τοπογραφικά]
[1. Δημιουργία Layers (DGML)]^C^C_DGML
[2. Κλίμακα σχεδίασης 1:100 - 1:2000 (DGMSCALE)]^C^C_DGMSCALE
[3. Κάναβος σχεδίασης + σύμβολο βορρά (DGMGRID)]^C^C_DGMGRID
[Κάναβος-φύλλο 609mm x κλίμακα, αυτόματο μήκος (DGMSHEET)]^C^C_DGMSHEET
[Απόσπασμα ορθοφωτοχάρτη TOPO_PROP - Κτηματολόγιο (DGMORTHO)]^C^C_DGMORTHO
[--]
[4. Καθαρισμός τυπικών σφαλμάτων - Cleanup (DGMCLEAN)]^C^C_DGMCLEAN
[5. Έλεγχος ορθότητας σχεδίου (DGMC)]^C^C_DGMC
[Σχεδόν-συμπίπτουσες κορυφές ΔΓΜ - κόκκινοι κύκλοι (DGMNEAR)]^C^C_DGMNEAR
[--]
[6. Αλλαγή αρχής-φοράς κλειστής polyline (DGMORIGIN)]^C^C_DGMORIGIN
[7. Αρίθμηση κορυφών μαζική + διαστάσεις πλευρών (DGMK)]^C^C_DGMK
[8. Αρίθμηση + ΟΛΟΙ οι πίνακες αυτόματα (DGMAUTO)]^C^C_DGMAUTO
[Πίνακες επιλεγμένων polylines (DGMPALL)]^C^C_DGMPALL
[Πίνακας συντεταγμένων μίας polyline (DGMP)]^C^C_DGMP
[Εξαγωγή συντεταγμένων σε TXT (DGMTXT)]^C^C_DGMTXT
[--]
[9. Προετοιμασία σχεδίου για υποβολή (DGMPREP)]^C^C_DGMPREP
[10. Hash SHA512 αρχείου DXF (DGMHASH)]^C^C_DGMHASH
[11. Υπογραφή PDF με JSignPdf (DGMSIGN)]^C^C_DGMSIGN
[12. ZIP αρχείων προς παράδοση (DGMZIP)]^C^C_DGMZIP
[--]
[Τοποθέτηση ΚΗΔ στο σχέδιο (DGMKHD)]^C^C_DGMKHD
[Λίστα εντολών (DGMHELP)]^C^C_DGMHELP

***POP2
**DGMDGM
[ΔΓΜ]
[->Ροή Εργασίας]
  [->Α. ΔΓΜ για Πράξη (κατάτμηση/συνένωση)]
    [1. Δημιουργία Layers (DGML)]^C^C_DGML
    [2. (χειροκίνητα) Εισαγωγή αρχικών ΚΑΕΚ PST_KAEK + αριθμών]^C^C
    [3. (προαιρετικά) Ορθοφωτοχάρτης αναφοράς (DGMORTHO)]^C^C_DGMORTHO
    [4. Καθαρισμός σφαλμάτων (DGMCLEAN)]^C^C_DGMCLEAN
    [5. Δημιουργία πολυγώνων από σημείο (DGMBND)]^C^C_DGMBND
    [6. DGM_PROP_FINAL: Κατάτμηση PST_KAEK με LINE_XM (DGMKAT)]^C^C_DGMKAT
    [7. Συνένωση όμορων πολυγώνων (DGMUNION)]^C^C_DGMUNION
    [8. Κατάτμηση πολυγώνου με γραμμή κοπής (DGMSPLIT)]^C^C_DGMSPLIT
    [9. Αποκοπή τμήματος από γεωτεμάχιο (DGMCUT)]^C^C_DGMCUT
    [10. DGM_PROP_FINAL: Αυτόματα υπόλοιπα από PST_KAEK (DGMGM)]^C^C_DGMGM
    [11. Χαρακτηρισμός τμημάτων Α (προστίθενται) / Δ (αφαιρούνται) (DGMA)]^C^C_DGMA
    [12. Δημιουργία AREA_A και AREA_D (DGMAREAS)]^C^C_DGMAREAS
    [13. Έλεγχος ορθότητας σχεδίου (DGMC)]^C^C_DGMC
    [14. Σχεδόν-συμπίπτουσες κορυφές (DGMNEAR)]^C^C_DGMNEAR
    [15. Αρχή/φορά κλειστών polyline (DGMORIGIN)]^C^C_DGMORIGIN
    [16. Αρίθμηση κορυφών + διαστάσεις (DGMK)]^C^C_DGMK
    [17. Αρίθμηση + ΟΛΟΙ οι πίνακες αυτόματα (DGMAUTO)]^C^C_DGMAUTO
    [18. Πίνακας τμημάτων Αi και Δi (DGMTA)]^C^C_DGMTA
    [19. Πίνακας αρχικών και τελικών εμβαδών (DGME)]^C^C_DGME
    [20. Σκαριφήματα ΚΑΕΚ (DGMSKETCH)]^C^C_DGMSKETCH
    [21. Τοποθέτηση ΚΗΔ στο σχέδιο (DGMKHD)]^C^C_DGMKHD
    [22. Προετοιμασία σχεδίου για υποβολή (DGMPREP)]^C^C_DGMPREP
    [23. Hash SHA512 αρχείου DXF (DGMHASH)]^C^C_DGMHASH
    [24. Υπογραφή PDF με JSignPdf (DGMSIGN)]^C^C_DGMSIGN
    [<-25. ZIP αρχείων προς παράδοση (DGMZIP)]^C^C_DGMZIP
  [->Β. ΔΓΜ για διόρθωση ορίων]
    [1. Δημιουργία Layers (DGML)]^C^C_DGML
    [2. (χειροκίνητα) Εισαγωγή αρχικών ΚΑΕΚ PST_KAEK + αριθμών]^C^C
    [3. (προαιρετικά) Ορθοφωτοχάρτης αναφοράς (DGMORTHO)]^C^C_DGMORTHO
    [4. Καθαρισμός σφαλμάτων (DGMCLEAN)]^C^C_DGMCLEAN
    [5. (χειροκίνητα) Σχεδίαση ορθού ορίου στο TOPO_PROP]^C^C
    [6. DGM_PROP_FINAL - BOUND_IMPL - BOUND_UNIMPL από TOPO_PROP (DGMCOPY)]^C^C_DGMCOPY
    [7. VST_FINAL από LINE_XM_VST (DGMVST)]^C^C_DGMVST
    [8. DGM_PROP_FINAL: Αυτόματα υπόλοιπα από PST_KAEK (DGMGM)]^C^C_DGMGM
    [9. Έλεγχος ορθότητας σχεδίου (DGMC)]^C^C_DGMC
    [10. Σχεδόν-συμπίπτουσες κορυφές (DGMNEAR)]^C^C_DGMNEAR
    [11. Αρχή/φορά κλειστών polyline (DGMORIGIN)]^C^C_DGMORIGIN
    [12. Αρίθμηση κορυφών + διαστάσεις (DGMK)]^C^C_DGMK
    [13. Αρίθμηση + ΟΛΟΙ οι πίνακες αυτόματα (DGMAUTO)]^C^C_DGMAUTO
    [14. Πίνακας για τη διόρθωση των γεωτεμαχίων (DGMT)]^C^C_DGMT
    [15. Πίνακας αρχικών και τελικών εμβαδών (DGME)]^C^C_DGME
    [16. Σκαριφήματα ΚΑΕΚ (DGMSKETCH)]^C^C_DGMSKETCH
    [17. Τοποθέτηση ΚΗΔ στο σχέδιο (DGMKHD)]^C^C_DGMKHD
    [18. Προετοιμασία σχεδίου για υποβολή (DGMPREP)]^C^C_DGMPREP
    [19. Hash SHA512 αρχείου DXF (DGMHASH)]^C^C_DGMHASH
    [20. Υπογραφή PDF με JSignPdf (DGMSIGN)]^C^C_DGMSIGN
    [<-<-21. ZIP αρχείων προς παράδοση (DGMZIP)]^C^C_DGMZIP
[--]
[1. Δημιουργία Layers (DGML)]^C^C_DGML
[2. Καθαρισμός τυπικών σφαλμάτων - Cleanup (DGMCLEAN)]^C^C_DGMCLEAN
[->3. Δημιουργία Πολυγώνων]
  [Πολύγωνο από εσωτερικό σημείο (DGMBND)]^C^C_DGMBND
  [Πολύγωνο από σημείο - μόνο PST_KAEK και DGM_PROP_FINAL (DGMBNDPD)]^C^C_DGMBNDPD
  [--]
  [DGM_PROP_FINAL: Κατάτμηση PST_KAEK με LINE_XM (DGMKAT)]^C^C_DGMKAT
  [DGM_PROP_FINAL: Αυτόματα υπόλοιπα από PST_KAEK (DGMGM)]^C^C_DGMGM
  [VST_FINAL από LINE_XM_VST (DGMVST)]^C^C_DGMVST
  [--]
  [Κατάτμηση πολυγώνου με γραμμή κοπής (DGMSPLIT)]^C^C_DGMSPLIT
  [Συνένωση όμορων πολυγώνων (DGMUNION)]^C^C_DGMUNION
  [<-Αποκοπή τμήματος από γεωτεμάχιο (DGMCUT)]^C^C_DGMCUT
[->4. Αντιγραφή στοιχείων Layer]
  [DGM_PROP_FINAL - BOUND_IMPL - BOUND_UNIMPL από TOPO_PROP (DGMCOPY)]^C^C_DGMCOPY
  [<-Χειροκίνητος χαρακτηρισμός τμήματος Α-Δ (DGMA)]^C^C_DGMA
[5. Δημιουργία AREA_A και AREA_D (DGMAREAS)]^C^C_DGMAREAS
[->Σκαριφήματα ΚΑΕΚ]
  [Σκαρίφημα Αρχικών ΚΑΕΚ - PST_KAEK, καφέ solid (DGMSKETCH)]^C^C_DGMSKETCH
  [<-Σκαρίφημα Τελικών ΚΑΕΚ - DGM_PROP_FINAL, μπλε solid (DGMSKETCH)]^C^C_DGMSKETCH
[6. Έλεγχος ορθότητας σχεδίου (DGMC)]^C^C_DGMC
[Σχεδόν-συμπίπτουσες κορυφές ΔΓΜ - κόκκινοι κύκλοι (DGMNEAR)]^C^C_DGMNEAR
[--]
[7. Αλλαγή αρχής-φοράς κλειστής polyline (DGMORIGIN)]^C^C_DGMORIGIN
[8. Αρίθμηση κορυφών μαζική + διαστάσεις πλευρών (DGMK)]^C^C_DGMK
[->9. Πίνακες]
  [Αρίθμηση + ΟΛΟΙ οι πίνακες αυτόματα - ιδιοκτησία, αρχικά, τελικά (DGMAUTO)]^C^C_DGMAUTO
  [--]
  [Πίνακες όλων των polylines αυτόματα (DGMPALL)]^C^C_DGMPALL
  [Πίνακας συντεταγμένων μίας polyline (DGMP)]^C^C_DGMP
  [Πίνακας τμημάτων Αi και Δi - AREA_A / AREA_D (DGMTA)]^C^C_DGMTA
  [Πίνακας αρχικών και τελικών εμβαδών (DGME)]^C^C_DGME
  [Πίνακας για τη διόρθωση των γεωτεμαχίων (DGMT)]^C^C_DGMT
  [<-Εξαγωγή συντεταγμένων σε TXT (DGMTXT)]^C^C_DGMTXT
[--]
[10. Προετοιμασία σχεδίου για υποβολή (DGMPREP)]^C^C_DGMPREP
[11. Hash SHA512 αρχείου DXF (DGMHASH)]^C^C_DGMHASH
[12. Υπογραφή PDF με JSignPdf (DGMSIGN)]^C^C_DGMSIGN
[13. ZIP αρχείων προς παράδοση (DGMZIP)]^C^C_DGMZIP
[--]
[Τοποθέτηση ΚΗΔ στο σχέδιο (DGMKHD)]^C^C_DGMKHD
[Λίστα εντολών (DGMHELP)]^C^C_DGMHELP
